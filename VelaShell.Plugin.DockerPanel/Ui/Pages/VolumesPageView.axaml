<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VelaShell.Plugin.DockerPanel.Ui"
             xmlns:pages="clr-namespace:VelaShell.Plugin.DockerPanel.Ui.Pages"
             x:Class="VelaShell.Plugin.DockerPanel.Ui.Pages.VolumesPageView"
             x:DataType="pages:VolumesPageViewModel">

  <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

      <Border Grid.Row="0" Classes="toolbar">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="卷" Classes="h1" />
          <TextBlock Grid.Column="1" Text="{Binding TotalCount}" Classes="meta" Margin="8,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding TotalSizeText}" Classes="meta" Margin="10,0,0,0" />

          <Border Grid.Column="3" Classes="input" Width="200" Height="26" Margin="12,0,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <ui:Glyph Grid.Column="0" Key="Icon.search" Size="12" Brush="{DynamicResource VelaTextTertiary}" />
              <TextBox Grid.Column="1" Classes="bare" Margin="7,0,0,0" Text="{Binding Search}"
                       PlaceholderText="按卷名或项目过滤…" />
            </Grid>
          </Border>

          <Button Grid.Column="5" Theme="{StaticResource DockerToolButton}" Margin="0,0,8,0"
                  BorderBrush="{DynamicResource VelaShellRedDim}" Command="{Binding PruneCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.shield-alert" Size="13" Brush="{DynamicResource VelaError}" />
              <TextBlock Text="{Binding UnusedCount, StringFormat='清理未使用 ({0})'}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaError}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="6" Theme="{StaticResource DockerToolButton}" Margin="0,0,8,0"
                  Background="{DynamicResource VelaAccent}" BorderBrush="Transparent"
                  Command="{Binding CreateCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Icon.plus" Size="13" Brush="{DynamicResource VelaAccentForeground}" />
              <TextBlock Text="新建卷…" FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium"
                         Foreground="{DynamicResource VelaAccentForeground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="7" Theme="{StaticResource DockerIconButton}" Command="{Binding RefreshCommand}">
            <ui:Glyph Key="Icon.refresh-cw" Size="14" Brush="{DynamicResource VelaTextTertiary}" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="header-row">
        <Grid ColumnDefinitions="*,90,150,100,120,110">
          <TextBlock Grid.Column="0" Text="名称" Classes="col" Margin="12,0,0,0" />
          <TextBlock Grid.Column="1" Text="驱动" Classes="col" />
          <TextBlock Grid.Column="2" Text="使用者" Classes="col" />
          <TextBlock Grid.Column="3" Text="大小" Classes="col" />
          <TextBlock Grid.Column="4" Text="创建" Classes="col" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" Background="{DynamicResource VelaBgSurface}">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding View}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ui:VolumeRow">
                <Button Theme="{StaticResource DockerIconButton}" Width="NaN" Height="NaN" CornerRadius="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                        Command="{Binding $parent[ItemsControl].((pages:VolumesPageViewModel)DataContext).SelectCommand}"
                        CommandParameter="{Binding}">
                  <Grid Height="32" ColumnDefinitions="*,90,150,100,120,110">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" Margin="12,0"
                                VerticalAlignment="Center">
                      <ui:Glyph Key="Docker.database" Size="13"
                                Brush="{Binding Tone, Converter={x:Static ui:Converters.ToneBrush}}" />
                      <TextBlock Text="{Binding Name}" Classes="name" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Driver}" Classes="cell" />
                    <TextBlock Grid.Column="2" Text="{Binding UsageText}" Classes="cell"
                               Foreground="{Binding Tone, Converter={x:Static ui:Converters.ToneBrush}}" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="cell" />
                    <TextBlock Grid.Column="4" Text="{Binding CreatedText}" Classes="cell" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Right"
                                Margin="0,0,6,0" VerticalAlignment="Center">
                      <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22"
                              ToolTip.Tip="浏览卷内文件"
                              Command="{Binding $parent[ItemsControl].((pages:VolumesPageViewModel)DataContext).BrowseCommand}"
                              CommandParameter="{Binding}">
                        <ui:Glyph Key="Icon.folder-open" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
                      </Button>
                      <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22" ToolTip.Tip="删除…"
                              Command="{Binding $parent[ItemsControl].((pages:VolumesPageViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <ui:Glyph Key="Icon.trash-2" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="这台机器上还没有卷" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="容器把数据写在可写层里,容器一删就没了 —— 要留住数据就得有卷。" Classes="hint"
                     TextAlignment="Center" MaxWidth="360" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- 详情 -->
    <Border Grid.Column="1" Width="360" IsVisible="{Binding HasSelection}"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="14,12" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Glyph Key="Docker.database" Size="15" Brush="{DynamicResource VelaAccent}" />
            <TextBlock Text="{Binding Selected.Name}" Classes="h2" />
          </StackPanel>

          <Border Classes="divider" />
          <TextBlock Text="基本信息" Classes="h3" />
          <Grid ColumnDefinitions="80,*" Height="22">
            <TextBlock Grid.Column="0" Text="驱动" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.Driver}" Classes="cell" />
          </Grid>
          <Grid ColumnDefinitions="80,*">
            <TextBlock Grid.Column="0" Text="挂载点" Classes="label" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.Mountpoint}" Classes="cell" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="80,*" Height="22">
            <TextBlock Grid.Column="0" Text="大小" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.SizeText}" Classes="cell" />
          </Grid>
          <Grid ColumnDefinitions="80,*" Height="22">
            <TextBlock Grid.Column="0" Text="创建于" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.CreatedText}" Classes="cell" />
          </Grid>

          <Border Classes="divider" />
          <TextBlock Text="使用者" Classes="h3" />
          <ItemsControl ItemsSource="{Binding SelectedUsers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="cell" Margin="0,0,0,3" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding BrowseHint}" Classes="hint" />

          <Border Classes="divider" />
          <TextBlock Text="标签" Classes="h3" />
          <ItemsControl ItemsSource="{Binding SelectedLabels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:DetailField">
                <Grid ColumnDefinitions="120,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="label"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="cell" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="(无)" Classes="hint" IsVisible="{Binding !SelectedLabels.Count}" />

          <Border Classes="divider" />
          <TextBlock Text="驱动选项" Classes="h3" />
          <ItemsControl ItemsSource="{Binding SelectedOptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:DetailField">
                <Grid ColumnDefinitions="120,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="label" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="cell" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="使用默认 local 驱动" Classes="hint" IsVisible="{Binding !SelectedOptions.Count}" />

          <Border Classes="divider" />
          <!-- 备份走的是浏览那条路:借一个挂着它的运行中容器,把挂载点整包取成 tar -->
          <Button Theme="{StaticResource DockerToolButton}" Height="26" HorizontalAlignment="Left"
                  IsEnabled="{Binding CanBackup}"
                  ToolTip.Tip="把卷里的内容整包存成本地 tar"
                  Command="{Binding BackupCommand}" CommandParameter="{Binding Selected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.file-archive" Size="13" Brush="{DynamicResource VelaTextSecondary}" />
              <TextBlock Text="备份为 tar…" FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaTextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Classes="divider" />
          <!-- 危险区:删卷永远是"会丢数据"那一档 -->
          <Border CornerRadius="6" Padding="12,10" Background="{DynamicResource VelaShellRedDim}"
                  BorderBrush="{DynamicResource VelaError}" BorderThickness="1">
            <StackPanel Spacing="7">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ui:Glyph Key="Icon.triangle-alert" Size="13" Brush="{DynamicResource VelaError}" />
                <TextBlock Text="危险操作" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold"
                           Foreground="{DynamicResource VelaError}" />
              </StackPanel>
              <TextBlock Text="删除卷会永久丢失里面的数据,且无法撤销。确认框中需手打 delete。"
                         FontSize="{DynamicResource VelaFontSize10}"
                         Foreground="{DynamicResource VelaError}" TextWrapping="Wrap" LineHeight="16" />
              <Button Theme="{StaticResource DockerToolButton}" Height="26"
                      BorderBrush="{DynamicResource VelaError}"
                      Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:Glyph Key="Icon.trash-2" Size="12" Brush="{DynamicResource VelaError}" />
                  <TextBlock Text="删除卷…" FontSize="{DynamicResource VelaFontSize11}"
                             Foreground="{DynamicResource VelaError}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

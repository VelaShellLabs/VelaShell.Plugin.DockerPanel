<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VelaShell.Plugin.DockerPanel.Ui"
             xmlns:docker="clr-namespace:VelaShell.Plugin.DockerPanel.Docker"
             xmlns:pages="clr-namespace:VelaShell.Plugin.DockerPanel.Ui.Pages"
             x:Class="VelaShell.Plugin.DockerPanel.Ui.Pages.ComposePageView"
             x:DataType="pages:ComposePageViewModel">

  <!--
    三栏:项目列表 / compose.yaml 编辑器 + 服务表 / 执行记录。
    compose 走的是远端的 docker compose CLI —— Engine API 里没有 compose 这一块,
    在面板里重写一遍只会与远端装的那个版本行为不一致。
  -->

  <Grid ColumnDefinitions="260,*,400">

    <!-- 项目 -->
    <Border Grid.Column="0" Background="{DynamicResource VelaBgPage}"
            BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="Compose 项目" Classes="h2" />
            <TextBlock Grid.Column="1" Text="{Binding Projects.Count}" Classes="meta" Margin="8,0,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
              <Button Theme="{StaticResource DockerIconButton}" ToolTip.Tip="新建 Compose 项目…"
                      Command="{Binding NewProjectCommand}">
                <ui:Glyph Key="Icon.plus" Size="13" Brush="{DynamicResource VelaAccent}" />
              </Button>
              <Button Theme="{StaticResource DockerIconButton}" ToolTip.Tip="刷新"
                      Command="{Binding RefreshCommand}">
                <ui:Glyph Key="Icon.refresh-cw" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,10"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="7">
            <TextBlock Text="compose ls 只认得起过至少一次的项目 —— 别的用「按路径打开」。" Classes="hint" />
            <Button Theme="{StaticResource DockerToolButton}" Height="26" HorizontalAlignment="Stretch"
                    Command="{Binding OpenByPathCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Glyph Key="Icon.folder-open" Size="12" Brush="{DynamicResource VelaTextSecondary}" />
                <TextBlock Text="按路径打开…" FontSize="{DynamicResource VelaFontSize11}"
                           Foreground="{DynamicResource VelaTextSecondary}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <ScrollViewer>
          <StackPanel>
            <Border IsVisible="{Binding !ComposeAvailable}" Padding="12,10"
                    Background="{DynamicResource DockerWarnDim}">
              <TextBlock Text="{Binding UnavailableHint}" Classes="hint"
                         Foreground="{DynamicResource VelaWarning}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Projects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="docker:ComposeProject">
                  <Button Theme="{StaticResource DockerIconButton}" Width="NaN" Height="NaN" CornerRadius="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8"
                          Command="{Binding $parent[ItemsControl].((pages:ComposePageViewModel)DataContext).SelectCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <ui:Glyph Grid.Column="0" Key="Docker.boxes" Size="13" VerticalAlignment="Center"
                                  Brush="{DynamicResource VelaAccent}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="name" Margin="7,0,0,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="meta" />
                      </Grid>
                      <TextBlock Text="{Binding PrimaryFile}" Classes="meta" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 编辑器 + 服务 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding HasSelection}">
      <Border Grid.Row="0" Height="48" Padding="14,0" Background="{DynamicResource VelaBgContentHeader}"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Glyph Key="Docker.boxes" Size="15" Brush="{DynamicResource VelaAccent}" />
              <TextBlock Text="{Binding ProjectName}" Classes="h2" />
              <Border Classes="chip" Background="{DynamicResource VelaShellGreenDim}">
                <TextBlock Text="{Binding ProjectStatus}" FontSize="{DynamicResource VelaFontSize10}"
                           Foreground="{DynamicResource VelaStatusConnected}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <!-- 项目名 / compose 文件 / 项目目录 三个参数一起钉住,少一个都出错 -->
            <TextBlock Text="{Binding ProjectPrefix}" Classes="meta" FontSize="9" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    Command="{Binding PullCommand}">
              <TextBlock Text="pull" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    Command="{Binding BuildCommand}">
              <TextBlock Text="build" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    Command="{Binding RestartCommand}">
              <TextBlock Text="restart" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    Command="{Binding StopCommand}">
              <TextBlock Text="stop" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaTextSecondary}" />
            </Button>
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    BorderBrush="{DynamicResource VelaShellRedDim}" Command="{Binding DownCommand}">
              <TextBlock Text="down" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize11}"
                         Foreground="{DynamicResource VelaError}" />
            </Button>
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    Background="{DynamicResource VelaError}" BorderBrush="Transparent"
                    ToolTip.Tip="down -v 会把这个项目的命名卷一起删掉" Command="{Binding DownVolumesCommand}">
              <TextBlock Text="down -v" FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium" Foreground="#FFFFFF" />
            </Button>
            <Button Theme="{StaticResource DockerToolButton}" Height="26" IsEnabled="{Binding !Running}"
                    Background="{DynamicResource VelaAccent}" BorderBrush="Transparent"
                    Command="{Binding UpCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Glyph Key="Icon.play" Size="12" Brush="{DynamicResource VelaAccentForeground}" />
                <TextBlock Text="up -d" FontFamily="{DynamicResource VelaUiMonoFont}"
                           FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium"
                           Foreground="{DynamicResource VelaAccentForeground}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 五个页签:compose.yaml / .env / 服务 / config 展开 / 合并日志 -->
      <Border Grid.Row="1" Height="34" Padding="10,0" Background="{DynamicResource VelaBgPage}"
              BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <RadioButton Theme="{StaticResource DockerTabButton}" GroupName="composetab"
                       IsChecked="{Binding IsYamlTab, Mode=OneWay}" Command="{Binding SetTabCommand}"
                       CommandParameter="{x:Static pages:ComposeTab.Yaml}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.file-code" Size="12" Brush="{Binding $parent[RadioButton].Foreground}" />
              <TextBlock Text="compose.yaml" VerticalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Theme="{StaticResource DockerTabButton}" GroupName="composetab"
                       IsChecked="{Binding IsEnvTab, Mode=OneWay}" Command="{Binding SetTabCommand}"
                       CommandParameter="{x:Static pages:ComposeTab.Env}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.lock" Size="12" Brush="{Binding $parent[RadioButton].Foreground}" />
              <TextBlock Text=".env" VerticalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Theme="{StaticResource DockerTabButton}" GroupName="composetab"
                       IsChecked="{Binding IsServicesTab, Mode=OneWay}" Command="{Binding SetTabCommand}"
                       CommandParameter="{x:Static pages:ComposeTab.Services}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.list-tree" Size="12" Brush="{Binding $parent[RadioButton].Foreground}" />
              <TextBlock Text="{Binding Services.Count, StringFormat='服务 ({0})'}" VerticalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Theme="{StaticResource DockerTabButton}" GroupName="composetab"
                       IsChecked="{Binding IsConfigTab, Mode=OneWay}" Command="{Binding SetTabCommand}"
                       CommandParameter="{x:Static pages:ComposeTab.Config}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Icon.search" Size="12" Brush="{Binding $parent[RadioButton].Foreground}" />
              <TextBlock Text="config 展开" VerticalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Theme="{StaticResource DockerTabButton}" GroupName="composetab"
                       IsChecked="{Binding IsLogsTab, Mode=OneWay}" Command="{Binding SetTabCommand}"
                       CommandParameter="{x:Static pages:ComposeTab.Logs}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Glyph Key="Docker.scroll-text" Size="12" Brush="{Binding $parent[RadioButton].Foreground}" />
              <TextBlock Text="合并日志" VerticalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <!-- compose.yaml -->
      <DockPanel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsYamlTab}">
        <Border DockPanel.Dock="Top" Height="30" Padding="12,0" Background="{DynamicResource VelaBgPage}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding ProjectFile}" Classes="meta" />
            <Border Grid.Column="2" Classes="chip" Height="17" Margin="0,0,8,0" IsVisible="{Binding IsModified}"
                    Background="{DynamicResource DockerWarnDim}">
              <TextBlock Text="{Binding ModifiedText}" FontSize="{DynamicResource VelaFontSize9}"
                         Foreground="{DynamicResource VelaWarning}" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
              <Button Theme="{StaticResource DockerToolButton}" Height="22"
                      IsEnabled="{Binding IsModified}" Command="{Binding RevertCommand}">
                <TextBlock Text="撤销" FontSize="{DynamicResource VelaFontSize10}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
              </Button>
              <Button Theme="{StaticResource DockerToolButton}" Height="22"
                      IsEnabled="{Binding IsModified}" Background="{DynamicResource VelaAccent}"
                      BorderBrush="Transparent" Command="{Binding SaveCommand}">
                <TextBlock Text="保存…" FontSize="{DynamicResource VelaFontSize10}" FontWeight="Medium"
                           Foreground="{DynamicResource VelaAccentForeground}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="terminal">
          <Grid>
            <TextBox Text="{Binding Yaml}" AcceptsReturn="True" AcceptsTab="True"
                     Background="Transparent" BorderThickness="0" Padding="14,10"
                     FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize11}"
                     Foreground="{DynamicResource VelaShellWhite}"
                     CaretBrush="{DynamicResource VelaAccent}"
                     SelectionBrush="{DynamicResource VelaAccentDim}" TextWrapping="NoWrap" />
            <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error}" Classes="hint"
                       Foreground="{DynamicResource VelaError}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" />
          </Grid>
        </Border>
      </DockPanel>

      <!-- .env -->
      <DockPanel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsEnvTab}">
        <Border DockPanel.Dock="Top" Height="30" Padding="12,0" Background="{DynamicResource VelaBgPage}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="meta" Text="项目目录下的 .env —— compose 只认这一个" />
            <Border Grid.Column="2" Classes="chip" Height="17" Margin="0,0,8,0" IsVisible="{Binding EnvModified}"
                    Background="{DynamicResource DockerWarnDim}">
              <TextBlock Text="{Binding EnvModifiedText}" FontSize="{DynamicResource VelaFontSize9}"
                         Foreground="{DynamicResource VelaWarning}" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
              <Button Theme="{StaticResource DockerToolButton}" Height="22"
                      IsEnabled="{Binding EnvModified}" Command="{Binding RevertEnvCommand}">
                <TextBlock Text="撤销" FontSize="{DynamicResource VelaFontSize10}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
              </Button>
              <Button Theme="{StaticResource DockerToolButton}" Height="22"
                      IsEnabled="{Binding EnvModified}" Background="{DynamicResource VelaAccent}"
                      BorderBrush="Transparent" Command="{Binding SaveEnvCommand}">
                <TextBlock Text="保存…" FontSize="{DynamicResource VelaFontSize10}" FontWeight="Medium"
                           Foreground="{DynamicResource VelaAccentForeground}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="terminal">
          <Grid>
            <TextBox Text="{Binding Env}" AcceptsReturn="True" AcceptsTab="True"
                     Background="Transparent" BorderThickness="0" Padding="14,10"
                     FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize11}"
                     Foreground="{DynamicResource VelaShellWhite}"
                     CaretBrush="{DynamicResource VelaAccent}"
                     SelectionBrush="{DynamicResource VelaAccentDim}" TextWrapping="NoWrap" />
            <StackPanel IsVisible="{Binding !HasEnv}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" MaxWidth="380">
              <TextBlock Text="这个项目没有 .env" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Classes="hint" TextAlignment="Center"
                         Text="在上面直接写,保存时会在项目目录下建一个。已经在跑的容器要 up -d 重建才读得到新值。" />
            </StackPanel>
          </Grid>
        </Border>
      </DockPanel>

      <!-- 服务表:每行带日志 / 终端 / 重启 -->
      <ScrollViewer Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsServicesTab}">
        <StackPanel>
          <Border Classes="header-row" Padding="14,0">
            <Grid ColumnDefinitions="110,180,*,170,100" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="服务" Classes="col" />
              <TextBlock Grid.Column="1" Text="容器" Classes="col" />
              <TextBlock Grid.Column="2" Text="状态" Classes="col" />
              <TextBlock Grid.Column="3" Text="端口" Classes="col" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Services}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="docker:ComposeService">
                <Grid Height="32" ColumnDefinitions="110,180,*,170,100" Margin="14,0">
                  <TextBlock Grid.Column="0" Text="{Binding Service}" Classes="name" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="cell" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="cell" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding PortsText}" Classes="cell" VerticalAlignment="Center"
                             Foreground="{DynamicResource VelaInfo}" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22" ToolTip.Tip="这个服务的日志"
                            Command="{Binding $parent[ItemsControl].((pages:ComposePageViewModel)DataContext).ServiceLogsCommand}"
                            CommandParameter="{Binding}">
                      <ui:Glyph Key="Docker.scroll-text" Size="12" Brush="{DynamicResource VelaTextTertiary}" />
                    </Button>
                    <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22" ToolTip.Tip="进这个服务的终端"
                            Command="{Binding $parent[ItemsControl].((pages:ComposePageViewModel)DataContext).ServiceTerminalCommand}"
                            CommandParameter="{Binding}">
                      <ui:Glyph Key="Icon.terminal" Size="12" Brush="{DynamicResource VelaTextTertiary}" />
                    </Button>
                    <Button Theme="{StaticResource DockerIconButton}" Width="22" Height="22" ToolTip.Tip="重启这个服务"
                            Command="{Binding $parent[ItemsControl].((pages:ComposePageViewModel)DataContext).ServiceRestartCommand}"
                            CommandParameter="{Binding}">
                      <ui:Glyph Key="Docker.rotate-cw" Size="12" Brush="{DynamicResource VelaTextTertiary}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- config 展开 -->
      <Border Grid.Row="2" Grid.RowSpan="2" Classes="terminal" IsVisible="{Binding IsConfigTab}">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding Config}" Classes="code" Margin="14,10"
                               Foreground="{DynamicResource VelaShellWhite}" />
        </ScrollViewer>
      </Border>

      <!-- 合并日志:交给 compose logs -f 去并,它认得项目里有哪些服务 -->
      <DockPanel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsLogsTab}">
        <Border DockPanel.Dock="Top" Height="30" Padding="12,0" Background="{DynamicResource VelaBgPage}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="docker compose logs -f" Classes="meta"
                       FontFamily="{DynamicResource VelaUiMonoFont}" />
            <Button Grid.Column="2" Theme="{StaticResource DockerToolButton}" Height="22" Margin="0,0,6,0"
                    Command="{Binding ToggleLogsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{Binding LogsFollowing, Converter={x:Static ui:Converters.FeedbackBrush}, ConverterParameter=ok}" />
                <TextBlock Text="跟随" FontSize="{DynamicResource VelaFontSize10}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Theme="{StaticResource DockerIconButton}" ToolTip.Tip="清屏"
                    Command="{Binding ClearLogsCommand}">
              <ui:Glyph Key="Docker.eraser" Size="12" Brush="{DynamicResource VelaTextTertiary}" />
            </Button>
          </Grid>
        </Border>
        <Border Classes="terminal">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Logs}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:OutputLine">
                  <Grid ColumnDefinitions="Auto,*" Margin="12,0" MinHeight="17">
                    <TextBlock Grid.Column="0" Text="{Binding Time}" Width="66"
                               FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize10}"
                               Foreground="{DynamicResource DockerCodeComment}" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                         FontFamily="{DynamicResource VelaUiMonoFont}"
                                         FontSize="{DynamicResource VelaFontSize11}" VerticalAlignment="Center">
                      <SelectableTextBlock.Foreground>
                        <Binding Path="IsError">
                          <Binding.Converter>
                            <ui:LogLineForegroundConverter />
                          </Binding.Converter>
                        </Binding>
                      </SelectableTextBlock.Foreground>
                    </SelectableTextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>

    <StackPanel Grid.Column="1" IsVisible="{Binding !HasSelection}" VerticalAlignment="Center"
                HorizontalAlignment="Center" Spacing="10" MaxWidth="380">
      <TextBlock Text="选一个 compose 项目" Classes="h2" HorizontalAlignment="Center" />
      <TextBlock Text="左边列出的是**起过至少一次**的项目;还没起过的用「按路径打开」给一个远端路径。"
                 Classes="hint" TextAlignment="Center" />
    </StackPanel>

    <!-- 执行记录 -->
    <Border Grid.Column="2" Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="44" Padding="14,0"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <ui:Glyph Grid.Column="0" Key="Docker.square-terminal" Size="15" VerticalAlignment="Center"
                      Brush="{DynamicResource VelaTextSecondary}" />
            <TextBlock Grid.Column="1" Text="执行记录" Classes="h2" Margin="8,0,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Classes="chip" Height="18"
                      Background="{Binding ExitTone, Converter={x:Static ui:Converters.ToneBrush}, ConverterParameter=dim}">
                <TextBlock Text="{Binding ExitCodeText}" FontSize="{DynamicResource VelaFontSize9}"
                           VerticalAlignment="Center"
                           Foreground="{Binding ExitTone, Converter={x:Static ui:Converters.ToneBrush}}" />
              </Border>
              <Button Theme="{StaticResource DockerIconButton}" ToolTip.Tip="复制执行记录"
                      Command="{Binding CopyOutputCommand}">
                <ui:Glyph Key="Icon.copy" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
              </Button>
              <Button Theme="{StaticResource DockerIconButton}" ToolTip.Tip="清空"
                      Command="{Binding ClearOutputCommand}">
                <ui:Glyph Key="Docker.eraser" Size="13" Brush="{DynamicResource VelaTextTertiary}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="26" Padding="12,0"
                Background="{DynamicResource VelaBgContentHeader}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,1,0,0">
          <TextBlock Text="保留最近 2000 行 · stdout 与 stderr 分色" Classes="meta" VerticalAlignment="Center" />
        </Border>
        <Border Classes="terminal">
          <ScrollViewer Padding="12,8">
            <ItemsControl ItemsSource="{Binding Output}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:OutputLine">
                  <Grid ColumnDefinitions="56,*" MinHeight="17">
                    <TextBlock Grid.Column="0" Text="{Binding Time}"
                               FontFamily="{DynamicResource VelaUiMonoFont}"
                               FontSize="{DynamicResource VelaFontSize9}"
                               Foreground="{DynamicResource DockerCodeComment}" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                         FontFamily="{DynamicResource VelaUiMonoFont}"
                                         FontSize="{DynamicResource VelaFontSize10}" TextWrapping="Wrap">
                      <SelectableTextBlock.Foreground>
                        <MultiBinding>
                          <MultiBinding.Converter>
                            <ui:OutputLineForegroundConverter />
                          </MultiBinding.Converter>
                          <Binding Path="IsError" />
                          <Binding Path="IsCommand" />
                        </MultiBinding>
                      </SelectableTextBlock.Foreground>
                    </SelectableTextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

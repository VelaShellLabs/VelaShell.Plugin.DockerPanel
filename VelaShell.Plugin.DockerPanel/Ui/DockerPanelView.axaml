<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.Plugin.DockerPanel.Ui"
             x:Class="VelaShell.Plugin.DockerPanel.Ui.DockerPanelView"
             x:DataType="vm:DockerPanelViewModel">

  <!--
    Docker 面板。几何对齐宿主(DESIGN.md):36px 文档头 / 28px 页签条 / 28px 工具条 /
    26px 列头 / 28px 数据行 / 24px 状态条;配色一律走 {DynamicResource VelaXxx},
    明暗切换即时跟随 —— 插件面板本就该长得像宿主的一部分,而不是一个贴上来的窗口。

    布局是"列表在上、抽屉在下"而不是左右分栏:容器/镜像的行本身就宽(名字 + 镜像 +
    端口 + 状态),再切一半给详情,两边都不够看。抽屉里放 inspect / 日志 / 进程 /
    执行记录 —— 那正是用户在终端里 `docker inspect | less` 之后要看的东西。

    确认框与表单**贴在这个面板上**,不飘在屏幕中央:同时开着生产与测试两台机器的
    Docker 面板时,一个不写清主机的"确定删除 3 个卷吗"是这个插件能犯的最贵的错误。
  -->

  <UserControl.Styles>
    <!-- ── 文字 ────────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.col">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cell.name">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── 按钮 ────────────────────────────────────────────────────── -->
    <Style Selector="Button.tool">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tool.accent">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
    <!-- 危险动作单独染色:删除与"停止"排在同一条工具条上,颜色是唯一来得及被扫到的区别。 -->
    <Style Selector="Button.tool.danger">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
    </Style>

    <!-- 页签:选中态给一条顶部强调条,与 VelaDock 的标签同语言。 -->
    <Style Selector="Button.tab">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
    </Style>
    <Style Selector="Button.tab:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
    <Style Selector="Button.tab.on">
      <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    </Style>

    <!-- 抽屉页签:比主页签矮一档,免得两条页签条看起来同权。 -->
    <Style Selector="Button.sub">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
    </Style>
    <Style Selector="Button.sub.on">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>
    <Style Selector="Button.sub:disabled">
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- 工具条:间距靠子元素外边距而不是 WrapPanel 的间距属性 ——
         那两个属性是新近才有的,而这个插件要能对着任何一版宿主的 Avalonia 编译。 -->
    <Style Selector="WrapPanel.bar > :is(Control)">
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- ── 输入 ────────────────────────────────────────────────────── -->
    <Style Selector="TextBox.field">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox.opt">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── 列表 ────────────────────────────────────────────────────── -->
    <Style Selector="ListBox.rows">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- 悬停 VelaBgHover、选中 VelaBgActive:与宿主资源管理器同一对令牌。
         Fluent 自带的选中色是另一套,不压掉就会和宿主两个样。 -->
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected TextBlock.name">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ── 状态条(容器行最左那道竖杠)────────────────────────────────
         用一道 3px 的色条而不是一个圆点:圆点在 28px 的行里要占一整格,
         而这一列的信息量只有"在跑 / 停了 / 暂停 / 不健康"四种。 -->
    <Style Selector="Border.state">
      <Setter Property="Width" Value="3" />
      <Setter Property="Background" Value="{DynamicResource VelaStatusDisconnected}" />
    </Style>
    <Style Selector="Border.state.running">
      <Setter Property="Background" Value="{DynamicResource VelaStatusConnected}" />
    </Style>
    <Style Selector="Border.state.paused">
      <Setter Property="Background" Value="{DynamicResource VelaWarning}" />
    </Style>
    <Style Selector="Border.state.unhealthy">
      <Setter Property="Background" Value="{DynamicResource VelaError}" />
    </Style>

    <!-- ── 徽章 ────────────────────────────────────────────────────── -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>

    <!-- 面板内的卡片(确认框 / 表单)。 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MaxWidth" Value="620" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel Background="{DynamicResource VelaBgDockDocument}">

    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="28" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="80" />
        <RowDefinition Height="Auto" />
        <!-- 抽屉那一行的高度双向绑到视图模型:用户拖分割条改的就是它,
             收起时它被压成 0(而不是留一个看不见的空行)。 -->
        <RowDefinition MinHeight="0" />   <!-- 抽屉:高度由代码后置双向绑到 DrawerHeight,见 .axaml.cs -->
        <RowDefinition Height="24" />
      </Grid.RowDefinitions>

      <!-- ══ 文档头:会话 · 引擎状态 · 计数 · 刷新 ══════════════════════ -->
      <Border Grid.Row="0"
              Background="{DynamicResource VelaBgContentHeader}"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1"
              Padding="10,0">
        <Grid ColumnDefinitions="Auto,220,Auto,*,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Classes="col" Text="{Binding Text[Header_Session]}" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1"
                    Classes="field"
                    ItemsSource="{Binding Sessions}"
                    SelectedItem="{Binding SelectedSession}"
                    PlaceholderText="{Binding Text[Header_NoSessions]}"
                    HorizontalAlignment="Stretch" />

          <!-- 引擎状态。可用时是一枚强调色徽章;不可用时是一整句能照着做的话
               (加进 docker 组 / 打开 sudo / daemon 没起),而不是一个红叉。 -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
            <Border Classes="badge" IsVisible="{Binding IsEngineReady}">
              <TextBlock Text="{Binding EngineText}" />
            </Border>
            <TextBlock Classes="meta" Text="{Binding EngineDetail}" IsVisible="{Binding HasEngineDetail}" />
            <TextBlock Classes="cell"
                       Foreground="{DynamicResource VelaWarning}"
                       Text="{Binding EngineText}"
                       IsVisible="{Binding !IsEngineReady}" />
          </StackPanel>

          <TextBlock Grid.Column="3" Classes="meta" Text="{Binding CountsText}" Margin="12,0" HorizontalAlignment="Right" />

          <TextBlock Grid.Column="4" Classes="col" Text="{Binding Text[Header_AutoRefresh]}" Margin="0,0,6,0" />
          <ComboBox Grid.Column="5"
                    Classes="field"
                    Width="86"
                    ItemsSource="{Binding RefreshChoices}"
                    SelectedItem="{Binding SelectedRefreshChoice}" />
          <Button Grid.Column="6"
                  Classes="tool"
                  Margin="8,0,0,0"
                  Content="{Binding Text[Header_Refresh]}"
                  Command="{Binding RefreshCommand}" />
          <Button Grid.Column="7"
                  Classes="tool"
                  Margin="6,0,0,0"
                  Content="{Binding Text[Header_Settings]}"
                  Command="{Binding ToggleSettingsCommand}" />
        </Grid>
      </Border>

      <!-- ══ 设置行(默认收起)════════════════════════════════════════ -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsSettingsOpen}"
              Background="{DynamicResource VelaBgSurface}"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1"
              Padding="12,10">
        <StackPanel Spacing="8">
          <CheckBox Classes="opt" IsChecked="{Binding UseSudo}" Content="{Binding Text[Header_Sudo]}" />
          <TextBlock Classes="hint" Text="{Binding Text[Header_SudoHint]}" />
          <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="col" Text="{Binding Text[Header_DockerHost]}" />
            <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Margin="0,0,12,0"
                     Text="{Binding DockerHostValue}" PlaceholderText="unix:///var/run/docker.sock" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="col" Text="{Binding Text[Header_DockerContext]}" />
            <TextBox Grid.Row="0" Grid.Column="3" Classes="field" Text="{Binding DockerContextValue}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Margin="0,4,12,0" Text="{Binding Text[Header_DockerHostHint]}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Classes="hint" Margin="0,4,0,0" Text="{Binding Text[Header_DockerContextHint]}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="tool accent" Content="{Binding Text[Header_Apply]}" Command="{Binding ApplySettingsCommand}" />
            <Button Classes="tool" Content="{Binding Text[Header_Close]}" Command="{Binding ToggleSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ 页签条 ══════════════════════════════════════════════════ -->
      <Border Grid.Row="2"
              Background="{DynamicResource VelaBgPage}"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Classes="tab" Classes.on="{Binding IsContainersTab}"
                    Content="{Binding Text[Tab_Containers]}"
                    Command="{Binding SelectTabCommand}" CommandParameter="Containers" />
            <Button Classes="tab" Classes.on="{Binding IsImagesTab}"
                    Content="{Binding Text[Tab_Images]}"
                    Command="{Binding SelectTabCommand}" CommandParameter="Images" />
            <Button Classes="tab" Classes.on="{Binding IsVolumesTab}"
                    Content="{Binding Text[Tab_Volumes]}"
                    Command="{Binding SelectTabCommand}" CommandParameter="Volumes" />
            <Button Classes="tab" Classes.on="{Binding IsNetworksTab}"
                    Content="{Binding Text[Tab_Networks]}"
                    Command="{Binding SelectTabCommand}" CommandParameter="Networks" />
            <Button Classes="tab" Classes.on="{Binding IsComposeTab}"
                    Content="{Binding Text[Tab_Compose]}"
                    Command="{Binding SelectTabCommand}" CommandParameter="Compose" />
            <Button Classes="tab" Classes.on="{Binding IsSystemTab}"
                    Content="{Binding Text[Tab_System]}"
                    Command="{Binding SelectTabCommand}" CommandParameter="System" />
          </StackPanel>
          <TextBox Grid.Column="2"
                   Classes="field"
                   Width="220"
                   Margin="8,2"
                   IsVisible="{Binding ShowsList}"
                   Text="{Binding Filter}"
                   PlaceholderText="{Binding Text[Common_Filter]}" />
        </Grid>
      </Border>

      <!-- ══ 工具条(按页签换一整排)══════════════════════════════════ -->
      <Border Grid.Row="3"
              Background="{DynamicResource VelaBgPage}"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1"
              Padding="10,5">
        <Panel>
          <!-- 容器 -->
          <WrapPanel Classes="bar" IsVisible="{Binding IsContainersTab}">
            <Button Classes="tool" Content="{Binding Text[Container_Start]}" Command="{Binding StartContainersCommand}" />
            <Button Classes="tool" Content="{Binding Text[Container_Stop]}" Command="{Binding StopContainersCommand}" />
            <Button Classes="tool" Content="{Binding Text[Container_Restart]}" Command="{Binding RestartContainersCommand}" />
            <Button Classes="tool" Content="{Binding Text[Container_Pause]}" Command="{Binding PauseContainersCommand}" />
            <Button Classes="tool" Content="{Binding Text[Container_Unpause]}" Command="{Binding UnpauseContainersCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Container_Kill]}" Command="{Binding KillContainersCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Container_Remove]}" Command="{Binding RemoveContainersCommand}" />
            <Border Width="1" Height="18" Background="{DynamicResource VelaBorderPrimary}" Margin="4,0" />
            <Button Classes="tool accent" Content="{Binding Text[Container_Terminal]}" Command="{Binding ShellContainerCommand}" />
            <Button Classes="tool" Content="{Binding Text[Container_Rename]}" Command="{Binding RenameContainerCommand}" />
            <Button Classes="tool" Content="{Binding Text[Container_RestartPolicy]}" Command="{Binding RestartPolicyCommand}" />
            <Button Classes="tool" Content="{Binding Text[Common_CopyId]}" Command="{Binding CopyContainerIdCommand}" />
            <Border Width="1" Height="18" Background="{DynamicResource VelaBorderPrimary}" Margin="4,0" />
            <CheckBox Classes="opt" IsChecked="{Binding ShowAllContainers}"
                      Content="{Binding Text[Common_ShowAll]}" ToolTip.Tip="{Binding Text[Common_ShowAllHint]}" />
            <CheckBox Classes="opt" IsChecked="{Binding ShowStats}" Content="CPU / MEM" Margin="8,0,0,0" />
            <CheckBox Classes="opt" IsChecked="{Binding ShowContainerSize}"
                      Content="{Binding Text[Common_WithSize]}" ToolTip.Tip="{Binding Text[Common_WithSizeHint]}" Margin="8,0,0,0" />
          </WrapPanel>

          <!-- 镜像 -->
          <WrapPanel Classes="bar" IsVisible="{Binding IsImagesTab}">
            <Button Classes="tool accent" Content="{Binding Text[Image_Pull]}" Command="{Binding PullImageCommand}" />
            <Button Classes="tool" Content="{Binding Text[Image_RunFrom]}" Command="{Binding RunImageCommand}" />
            <Button Classes="tool" Content="{Binding Text[Image_Tag]}" Command="{Binding TagImageCommand}" />
            <Button Classes="tool" Content="{Binding Text[Image_Push]}" Command="{Binding PushImageCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Image_Remove]}" Command="{Binding RemoveImagesCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Image_PruneDangling]}" Command="{Binding PruneDanglingCommand}" />
            <Button Classes="tool" Content="{Binding Text[Common_CopyId]}" Command="{Binding CopyImageIdCommand}" />
            <Border Width="1" Height="18" Background="{DynamicResource VelaBorderPrimary}" Margin="4,0" />
            <CheckBox Classes="opt" IsChecked="{Binding ShowAllImages}"
                      Content="{Binding Text[Common_ShowAll]}" ToolTip.Tip="{Binding Text[Common_ShowAllImagesHint]}" />
          </WrapPanel>

          <!-- 卷 -->
          <WrapPanel Classes="bar" IsVisible="{Binding IsVolumesTab}">
            <Button Classes="tool accent" Content="{Binding Text[Volume_Create]}" Command="{Binding CreateVolumeCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Volume_Remove]}" Command="{Binding RemoveVolumesCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Volume_Prune]}" Command="{Binding PruneVolumesCommand}" />
          </WrapPanel>

          <!-- 网络 -->
          <WrapPanel Classes="bar" IsVisible="{Binding IsNetworksTab}">
            <Button Classes="tool accent" Content="{Binding Text[Network_Create]}" Command="{Binding CreateNetworkCommand}" />
            <Button Classes="tool" Content="{Binding Text[Network_Connect]}" Command="{Binding ConnectNetworkCommand}" />
            <Button Classes="tool" Content="{Binding Text[Network_Disconnect]}" Command="{Binding DisconnectNetworkCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Network_Remove]}" Command="{Binding RemoveNetworksCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Network_Prune]}" Command="{Binding PruneNetworksCommand}" />
          </WrapPanel>

          <!-- Compose -->
          <WrapPanel Classes="bar" IsVisible="{Binding IsComposeTab}">
            <Button Classes="tool accent" Content="{Binding Text[Compose_Up]}" Command="{Binding ComposeUpCommand}" />
            <Button Classes="tool" Content="{Binding Text[Compose_Start]}" Command="{Binding ComposeStartCommand}" />
            <Button Classes="tool" Content="{Binding Text[Compose_Stop]}" Command="{Binding ComposeStopCommand}" />
            <Button Classes="tool" Content="{Binding Text[Compose_Restart]}" Command="{Binding ComposeRestartCommand}" />
            <Button Classes="tool" Content="{Binding Text[Compose_Pull]}" Command="{Binding ComposePullCommand}" />
            <Button Classes="tool" Content="{Binding Text[Compose_Build]}" Command="{Binding ComposeBuildCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Compose_Down]}" Command="{Binding ComposeDownCommand}" />
            <Border Width="1" Height="18" Background="{DynamicResource VelaBorderPrimary}" Margin="4,0" />
            <Button Classes="tool" Content="{Binding Text[Compose_Edit]}" Command="{Binding ComposeEditCommand}" />
            <Button Classes="tool" Content="{Binding Text[Compose_AddFile]}" Command="{Binding ComposeOpenFileCommand}" />
          </WrapPanel>

          <!-- 系统 -->
          <WrapPanel Classes="bar" IsVisible="{Binding IsSystemTab}">
            <TextBlock Classes="col" Text="{Binding Text[System_Prune]}" Margin="0,0,8,0" />
            <Button Classes="tool" Content="{Binding Text[Prune_Containers]}" Command="{Binding PruneContainersCommand}" />
            <Button Classes="tool" Content="{Binding Text[Prune_Images]}" Command="{Binding PruneImagesCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Prune_ImagesAll]}" Command="{Binding PruneAllImagesCommand}" />
            <Button Classes="tool" Content="{Binding Text[Prune_BuildCache]}" Command="{Binding PruneBuildCacheCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Prune_All]}" Command="{Binding PruneEverythingCommand}" />
            <Button Classes="tool danger" Content="{Binding Text[Prune_AllWithVolumes]}" Command="{Binding PruneEverythingWithVolumesCommand}" />
          </WrapPanel>
        </Panel>
      </Border>

      <!-- ══ 内容区 ══════════════════════════════════════════════════ -->
      <Panel Grid.Row="4">

        <!-- ── 容器 ─────────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding IsContainersTab}" RowDefinitions="26,*">
          <Border Grid.Row="0" Background="{DynamicResource VelaBgPage}" Padding="10,0">
            <Grid ColumnDefinitions="6,2*,2*,150,2*,66,110,100">
              <TextBlock Grid.Column="1" Classes="col" Text="{Binding Text[Col_Name]}" />
              <TextBlock Grid.Column="2" Classes="col" Text="{Binding Text[Col_Image]}" />
              <TextBlock Grid.Column="3" Classes="col" Text="{Binding Text[Col_Status]}" />
              <TextBlock Grid.Column="4" Classes="col" Text="{Binding Text[Col_Ports]}" />
              <TextBlock Grid.Column="5" Classes="col" Text="{Binding Text[Col_Cpu]}" />
              <TextBlock Grid.Column="6" Classes="col" Text="{Binding Text[Col_Mem]}" />
              <TextBlock Grid.Column="7" Classes="col" Text="{Binding Text[Col_Created]}" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1"
                   Name="ContainerList"
                   Classes="rows"
                   SelectionMode="Multiple"
                   ItemsSource="{Binding Containers}"
                   SelectionChanged="OnContainerSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerRow">
                <Border Height="28" Padding="10,0">
                  <Grid ColumnDefinitions="6,2*,2*,150,2*,66,110,100">
                    <Border Grid.Column="0" Classes="state"
                            Classes.running="{Binding Model.IsRunning}"
                            Classes.paused="{Binding Model.IsPaused}"
                            Classes.unhealthy="{Binding Model.IsUnhealthy}"
                            HorizontalAlignment="Left" Margin="0,5" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                      <TextBlock Classes="cell name" Text="{Binding Model.Name}" />
                      <TextBlock Classes="meta" Text="{Binding Model.ComposeProject}"
                                 IsVisible="{Binding Model.HasComposeProject}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Model.Image}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Model.Status}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Model.PortsDisplay}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="5" Classes="cell" Text="{Binding Cpu}" />
                    <TextBlock Grid.Column="6" Classes="cell" Text="{Binding Memory}" />
                    <TextBlock Grid.Column="7" Classes="meta" Text="{Binding Model.RunningFor}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Classes="hint" Margin="14,10" VerticalAlignment="Top"
                     Text="{Binding Text[Common_Empty]}" IsVisible="{Binding !HasContainers}" />
        </Grid>

        <!-- ── 镜像 ─────────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding IsImagesTab}" RowDefinitions="26,*">
          <Border Grid.Row="0" Background="{DynamicResource VelaBgPage}" Padding="10,0">
            <Grid ColumnDefinitions="6,3*,2*,130,100,120">
              <TextBlock Grid.Column="1" Classes="col" Text="{Binding Text[Col_Repository]}" />
              <TextBlock Grid.Column="2" Classes="col" Text="{Binding Text[Col_Tag]}" />
              <TextBlock Grid.Column="3" Classes="col" Text="{Binding Text[Col_ImageId]}" />
              <TextBlock Grid.Column="4" Classes="col" Text="{Binding Text[Col_Size]}" />
              <TextBlock Grid.Column="5" Classes="col" Text="{Binding Text[Col_Created]}" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1"
                   Name="ImageList"
                   Classes="rows"
                   SelectionMode="Multiple"
                   ItemsSource="{Binding Images}"
                   SelectionChanged="OnImageSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImageRow">
                <Border Height="28" Padding="10,0">
                  <Grid ColumnDefinitions="6,3*,2*,130,100,120">
                    <Border Grid.Column="0" Classes="state"
                            Classes.running="{Binding !Model.IsDangling}"
                            HorizontalAlignment="Left" Margin="0,5" />
                    <TextBlock Grid.Column="1" Classes="cell name" Text="{Binding Model.Repository}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Model.Tag}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Model.ShortId}" />
                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Model.Size}" />
                    <TextBlock Grid.Column="5" Classes="meta" Text="{Binding Model.CreatedSince}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Classes="hint" Margin="14,10" VerticalAlignment="Top"
                     Text="{Binding Text[Common_Empty]}" IsVisible="{Binding !HasImages}" />
        </Grid>

        <!-- ── 卷 ───────────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding IsVolumesTab}" RowDefinitions="26,*">
          <Border Grid.Row="0" Background="{DynamicResource VelaBgPage}" Padding="10,0">
            <Grid ColumnDefinitions="6,3*,110,4*,90">
              <TextBlock Grid.Column="1" Classes="col" Text="{Binding Text[Col_VolumeName]}" />
              <TextBlock Grid.Column="2" Classes="col" Text="{Binding Text[Col_Driver]}" />
              <TextBlock Grid.Column="3" Classes="col" Text="{Binding Text[Col_Mountpoint]}" />
              <TextBlock Grid.Column="4" Classes="col" Text="{Binding Text[Col_Scope]}" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1"
                   Name="VolumeList"
                   Classes="rows"
                   SelectionMode="Multiple"
                   ItemsSource="{Binding Volumes}"
                   SelectionChanged="OnVolumeSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VolumeRow">
                <Border Height="28" Padding="10,0">
                  <Grid ColumnDefinitions="6,3*,110,4*,90">
                    <TextBlock Grid.Column="1" Classes="cell name" Text="{Binding Model.Name}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Model.Driver}" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Model.Mountpoint}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Model.Scope}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Classes="hint" Margin="14,10" VerticalAlignment="Top"
                     Text="{Binding Text[Common_Empty]}" IsVisible="{Binding !HasVolumes}" />
        </Grid>

        <!-- ── 网络 ─────────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding IsNetworksTab}" RowDefinitions="26,*">
          <Border Grid.Row="0" Background="{DynamicResource VelaBgPage}" Padding="10,0">
            <Grid ColumnDefinitions="6,3*,130,120,90,80,80">
              <TextBlock Grid.Column="1" Classes="col" Text="{Binding Text[Col_NetworkName]}" />
              <TextBlock Grid.Column="2" Classes="col" Text="ID" />
              <TextBlock Grid.Column="3" Classes="col" Text="{Binding Text[Col_Driver]}" />
              <TextBlock Grid.Column="4" Classes="col" Text="{Binding Text[Col_Scope]}" />
              <TextBlock Grid.Column="5" Classes="col" Text="{Binding Text[Col_Internal]}" />
              <TextBlock Grid.Column="6" Classes="col" Text="{Binding Text[Col_IPv6]}" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1"
                   Name="NetworkList"
                   Classes="rows"
                   SelectionMode="Multiple"
                   ItemsSource="{Binding Networks}"
                   SelectionChanged="OnNetworkSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NetworkRow">
                <Border Height="28" Padding="10,0">
                  <Grid ColumnDefinitions="6,3*,130,120,90,80,80">
                    <TextBlock Grid.Column="1" Classes="cell name" Text="{Binding Model.Name}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="meta" Text="{Binding Model.ShortId}" />
                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Model.Driver}" />
                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Model.Scope}" />
                    <TextBlock Grid.Column="5" Classes="meta" Text="{Binding Model.Internal}" />
                    <TextBlock Grid.Column="6" Classes="meta" Text="{Binding Model.IPv6}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Classes="hint" Margin="14,10" VerticalAlignment="Top"
                     Text="{Binding Text[Common_Empty]}" IsVisible="{Binding !HasNetworks}" />
        </Grid>

        <!-- ── Compose ──────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding IsComposeTab}" RowDefinitions="26,*,Auto">
          <Border Grid.Row="0" Background="{DynamicResource VelaBgPage}" Padding="10,0">
            <Grid ColumnDefinitions="6,2*,160,4*">
              <TextBlock Grid.Column="1" Classes="col" Text="{Binding Text[Col_Project]}" />
              <TextBlock Grid.Column="2" Classes="col" Text="{Binding Text[Col_ProjectStatus]}" />
              <TextBlock Grid.Column="3" Classes="col" Text="{Binding Text[Col_ConfigFiles]}" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1"
                   Name="ComposeList"
                   Classes="rows"
                   SelectionMode="Single"
                   ItemsSource="{Binding ComposeProjects}"
                   SelectedItem="{Binding SelectedCompose}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ComposeRow">
                <Border Height="28" Padding="10,0">
                  <Grid ColumnDefinitions="6,2*,160,4*">
                    <Border Grid.Column="0" Classes="state"
                            Classes.running="{Binding Model.IsRunning}"
                            HorizontalAlignment="Left" Margin="0,5" />
                    <TextBlock Grid.Column="1" Classes="cell name" Text="{Binding Model.Name}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Model.Status}" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Model.ConfigFiles}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Classes="hint" Margin="14,10" VerticalAlignment="Top"
                     Text="{Binding Text[Compose_Unavailable]}" IsVisible="{Binding !IsComposeAvailable}" />
          <TextBlock Grid.Row="2" Classes="hint" Margin="14,6" Text="{Binding Text[Compose_Hint]}" />
        </Grid>

        <!-- ── 系统 ─────────────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding IsSystemTab}" Padding="12">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="title" Text="{Binding Text[System_DiskUsage]}" />
              <Border Background="{DynamicResource VelaBgTerminal}" CornerRadius="4" Padding="10">
                <SelectableTextBlock FontFamily="{DynamicResource VelaUiMonoFont}"
                                     FontSize="{DynamicResource VelaFontSize11}"
                                     Foreground="{DynamicResource VelaTextSecondary}"
                                     Text="{Binding SystemDiskText}" />
              </Border>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="title" Text="{Binding Text[System_Version]}" />
              <Border Background="{DynamicResource VelaBgTerminal}" CornerRadius="4" Padding="10">
                <SelectableTextBlock FontFamily="{DynamicResource VelaUiMonoFont}"
                                     FontSize="{DynamicResource VelaFontSize11}"
                                     Foreground="{DynamicResource VelaTextSecondary}"
                                     Text="{Binding SystemVersionText}" />
              </Border>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="title" Text="{Binding Text[System_Info]}" />
              <Border Background="{DynamicResource VelaBgTerminal}" CornerRadius="4" Padding="10">
                <SelectableTextBlock FontFamily="{DynamicResource VelaUiMonoFont}"
                                     FontSize="{DynamicResource VelaFontSize11}"
                                     Foreground="{DynamicResource VelaTextSecondary}"
                                     Text="{Binding SystemInfoText}" />
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>

      <!-- ══ 分割条 ══════════════════════════════════════════════════ -->
      <GridSplitter Grid.Row="5"
                    Height="4"
                    IsVisible="{Binding IsDrawerOpen}"
                    ResizeDirection="Rows"
                    Background="{DynamicResource VelaBorderPrimary}" />

      <!-- ══ 抽屉 ════════════════════════════════════════════════════ -->
      <Border Grid.Row="6"
              IsVisible="{Binding IsDrawerOpen}"
              Background="{DynamicResource VelaBgSurface}">
        <Grid RowDefinitions="26,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,2">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
              <Button Classes="sub" Classes.on="{Binding IsDetailsDrawer}"
                      Content="{Binding Text[Drawer_Details]}"
                      IsEnabled="{Binding CanShowDetails}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Details" />
              <Button Classes="sub" Classes.on="{Binding IsLogsDrawer}"
                      Content="{Binding Text[Drawer_Logs]}"
                      IsEnabled="{Binding CanShowLogs}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Logs"
                      IsVisible="{Binding IsContainersTab}" />
              <Button Classes="sub" Classes.on="{Binding IsTopDrawer}" Content="{Binding Text[Drawer_Top]}"
                      IsEnabled="{Binding CanShowContainerExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Top"
                      IsVisible="{Binding IsContainersTab}" />
              <Button Classes="sub" Classes.on="{Binding IsDiffDrawer}" Content="{Binding Text[Drawer_Diff]}"
                      IsEnabled="{Binding CanShowContainerExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Diff"
                      IsVisible="{Binding IsContainersTab}" />
              <Button Classes="sub" Classes.on="{Binding IsPortsDrawer}" Content="{Binding Text[Drawer_Ports]}"
                      IsEnabled="{Binding CanShowContainerExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Ports"
                      IsVisible="{Binding IsContainersTab}" />
              <Button Classes="sub" Classes.on="{Binding IsHistoryDrawer}" Content="{Binding Text[Drawer_History]}"
                      IsEnabled="{Binding CanShowHistory}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="History"
                      IsVisible="{Binding IsImagesTab}" />
              <Button Classes="sub" Classes.on="{Binding IsServicesDrawer}" Content="{Binding Text[Drawer_Services]}"
                      IsEnabled="{Binding CanShowComposeExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Services"
                      IsVisible="{Binding IsComposeTab}" />
              <Button Classes="sub" Classes.on="{Binding IsLogsDrawer}" Content="{Binding Text[Drawer_Logs]}"
                      IsEnabled="{Binding CanShowComposeExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Logs"
                      IsVisible="{Binding IsComposeTab}" />
              <Button Classes="sub" Classes.on="{Binding IsConfigDrawer}" Content="{Binding Text[Drawer_Config]}"
                      IsEnabled="{Binding CanShowComposeExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Config"
                      IsVisible="{Binding IsComposeTab}" />
              <Button Classes="sub" Classes.on="{Binding IsFileDrawer}"
                      Content="{Binding Text[Drawer_File]}"
                      IsEnabled="{Binding CanShowComposeExtras}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="File"
                      IsVisible="{Binding IsComposeTab}" />
              <Border Width="1" Height="14" Background="{DynamicResource VelaBorderPrimary}" Margin="6,0" />
              <Button Classes="sub" Classes.on="{Binding IsOutputDrawer}"
                      Content="{Binding Text[Drawer_Output]}"
                      Command="{Binding SelectDrawerCommand}" CommandParameter="Output" />
              <TextBlock Classes="meta" Text="{Binding DrawerTitle}" Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <!-- 日志专属:行数 / 时间戳 / 跟随 / 本地过滤。跟随不是 -f,理由见视图模型。 -->
              <ComboBox Classes="field" Width="80" IsVisible="{Binding IsLogsDrawer}"
                        ItemsSource="{Binding LogTailChoices}" SelectedItem="{Binding SelectedLogTailChoice}"
                        ToolTip.Tip="{Binding Text[Drawer_Tail]}" />
              <CheckBox Classes="opt" IsVisible="{Binding IsLogsDrawer}"
                        IsChecked="{Binding LogTimestamps}" Content="{Binding Text[Drawer_Timestamps]}" />
              <CheckBox Classes="opt" IsVisible="{Binding IsLogsDrawer}"
                        IsChecked="{Binding LogFollow}" Content="{Binding Text[Drawer_Follow]}"
                        ToolTip.Tip="{Binding Text[Drawer_FollowHint]}" />
              <TextBox Classes="field" Width="160" IsVisible="{Binding IsLogsDrawer}"
                       Text="{Binding LogFilter}" PlaceholderText="{Binding Text[Drawer_LogFilter]}" />
              <CheckBox Classes="opt" IsChecked="{Binding DrawerWrap}" Content="{Binding Text[Drawer_Wrap]}" />
              <Button Classes="tool accent" IsVisible="{Binding IsFileDrawer}"
                      Content="{Binding Text[Drawer_Save]}" Command="{Binding SaveDrawerCommand}" />
              <Button Classes="tool" Content="{Binding Text[Drawer_Reload]}" Command="{Binding ReloadDrawerCommand}" />
              <Button Classes="tool" Content="{Binding Text[Drawer_CopyAll]}" Command="{Binding CopyDrawerCommand}" />
              <Button Classes="tool" IsVisible="{Binding IsOutputDrawer}"
                      Content="{Binding Text[Drawer_Clear]}" Command="{Binding ClearDrawerCommand}" />
              <Button Classes="tool" Content="{Binding Text[Drawer_Hide]}" Command="{Binding HideDrawerCommand}" />
            </StackPanel>
          </Grid>

          <!-- 正文。用 TextBox 而不是 SelectableTextBlock:compose 文件那一档要能编辑,
               而两套控件切换会让滚动位置、选中态在切档时莫名其妙地跳。 -->
          <TextBox Grid.Row="1"
                   Classes="mono"
                   Text="{Binding DrawerText}"
                   IsReadOnly="{Binding !IsDrawerEditable}"
                   AcceptsReturn="True"
                   TextWrapping="{Binding DrawerTextWrapping}"
                   Background="{DynamicResource VelaBgTerminal}"
                   BorderThickness="0"
                   CornerRadius="0"
                   FontSize="{DynamicResource VelaFontSize11}"
                   Foreground="{DynamicResource VelaTextSecondary}"
                   Padding="10,6" />
        </Grid>
      </Border>

      <!-- ══ 状态条 ══════════════════════════════════════════════════ -->
      <Border Grid.Row="7"
              Background="{DynamicResource VelaBgContentHeader}"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,1,0,0"
              Padding="10,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                       Width="60" Height="2" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="meta" Text="{Binding SelectionSummary}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="2" Classes="meta" Text="{Binding Status}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ══ 确认闸门 ══════════════════════════════════════════════════
         盖住整个面板,而不是飘在屏幕上:标题里带着这条会话,用户不会删错主机。 -->
    <Border IsVisible="{Binding Confirm.IsOpen}" Background="#99000000">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Confirm.Title}"
                     FontSize="{DynamicResource VelaFontSize14}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource VelaTextPrimary}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding Confirm.Message}"
                     FontSize="{DynamicResource VelaFontSize11}"
                     Foreground="{DynamicResource VelaTextSecondary}"
                     TextWrapping="Wrap" />
          <Border Background="{DynamicResource VelaBgTerminal}" CornerRadius="4" Padding="10,8">
            <SelectableTextBlock Text="{Binding Confirm.Detail}"
                                 FontFamily="{DynamicResource VelaUiMonoFont}"
                                 FontSize="{DynamicResource VelaFontSize11}"
                                 Foreground="{DynamicResource VelaTextPrimary}"
                                 TextWrapping="Wrap" />
          </Border>
          <CheckBox Classes="opt" IsVisible="{Binding Confirm.HasOption}"
                    IsChecked="{Binding Confirm.OptionValue}" Content="{Binding Confirm.OptionLabel}" />
          <StackPanel Spacing="4" IsVisible="{Binding Confirm.RequiresTyping}">
            <TextBlock Classes="hint" Text="{Binding Confirm.TypePrompt}" />
            <TextBox Classes="field" Text="{Binding Confirm.TypedText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="tool" Content="{Binding Confirm.CancelLabel}" Command="{Binding Confirm.CancelCommand}" />
            <Button Classes="tool danger" Content="{Binding Confirm.ConfirmLabel}" Command="{Binding Confirm.ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ══ 表单层 ══════════════════════════════════════════════════════
         八种"几个输入框 + 一个按钮"的操作共用这一份声明式表单。
         顶上永远有一条命令预览 —— 用户按下"执行"之前就能看到那条会在生产机上跑的命令。 -->
    <Border IsVisible="{Binding Form.IsOpen}" Background="#99000000">
      <Border Classes="card" MaxHeight="560">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="{Binding Form.Title}"
                       FontSize="{DynamicResource VelaFontSize14}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VelaTextPrimary}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding Form.Description}" IsVisible="{Binding Form.HasDescription}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
            <StackPanel Spacing="3" IsVisible="{Binding Form.HasPreview}">
              <TextBlock Classes="col" Text="{Binding Form.PreviewLabel}" />
              <Border Background="{DynamicResource VelaBgTerminal}" CornerRadius="4" Padding="10,8">
                <SelectableTextBlock Text="{Binding Form.PreviewText}"
                                     FontFamily="{DynamicResource VelaUiMonoFont}"
                                     FontSize="{DynamicResource VelaFontSize11}"
                                     Foreground="{DynamicResource VelaAccentText}"
                                     TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="tool" Content="{Binding Form.CancelLabel}" Command="{Binding Form.CancelCommand}" />
              <Button Classes="tool accent" Content="{Binding Form.SubmitLabel}" Command="{Binding Form.SubmitCommand}" />
            </StackPanel>
          </StackPanel>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Form.Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FormField">
                  <StackPanel Spacing="3" Margin="0,0,0,10">
                    <TextBlock Classes="col" Text="{Binding Label}" IsVisible="{Binding !IsBoolean}" />
                    <TextBox Classes="field" IsVisible="{Binding IsText}"
                             Text="{Binding Value}" PlaceholderText="{Binding Placeholder}" />
                    <TextBox Classes="field mono" IsVisible="{Binding IsMultiline}"
                             Text="{Binding Value}" PlaceholderText="{Binding Placeholder}"
                             AcceptsReturn="True" Height="{Binding Height}" />
                    <CheckBox Classes="opt" IsVisible="{Binding IsBoolean}"
                              IsChecked="{Binding BoolValue}" Content="{Binding Label}" />
                    <ComboBox Classes="field" IsVisible="{Binding IsChoice}"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" />
                    <TextBlock Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Panel>

</UserControl>

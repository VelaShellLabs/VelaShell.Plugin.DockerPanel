<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear 掉机器级配置:插件仓要能在一台干净机器上照样还原,
         而不是依赖某个人本机恰好注册过的源。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- VelaShell SDK 的本地产出。SDK 与插件是两个仓,平时靠这个目录对接;
         发包之后这一条可以去掉。 -->
    <add key="vela-local" value="G:\VelaShell\artifacts\nuget" />
  </packageSources>
</configuration>

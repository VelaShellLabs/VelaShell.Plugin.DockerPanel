<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear 掉机器级配置:插件仓要能在一台干净机器上照样还原,
         而不是依赖某个人本机恰好注册过的源。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 本地联调一版还没发布的 SDK 时才打开。包在 nuget.org 上,平时**不需要**这一条。
         SDK 与工具链在 2026-08-27 拆成了两个仓库:
           VelaShellLabs/velashell-plugin-sdk  —— VelaShell.PluginSdk / .Testing
           VelaShellLabs/velashell-plugin-cli  —— VelaShell.PluginSdk.Build / vela-plugin
         在对应仓库 `dotnet pack ... -o artifacts/nuget -p:Vela...Version=1.6.0-dev`,
         把下面这行的注释去掉、路径改成你本地那个仓库,再把 csproj 里的版本临时指过去。
         ⚠️ 改完记得都改回去再提交:本地绝对路径进了仓库,别人和 CI 一还原就报「源不存在」
            —— NuGet 遇到不存在的本地源是直接把还原判失败,而不是跳过。 -->
    <!-- <add key="vela-local" value="G:\VelaShellLabs\velashell-plugin-cli\artifacts\nuget" /> -->
  </packageSources>
</configuration>
